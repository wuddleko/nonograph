[Unit]
Description=Nostorgraph
After=network-online.target tor.service
Wants=tor.service

[Service]
Type=simple
User=nostorgraph
Group=nostorgraph
WorkingDirectory=/var/lib/nostorgraph
ExecStart=/usr/local/bin/nostorgraph
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nostorgraph

[Install]
WantedBy=multi-user.target
