# Rust build artifacts
/target/

# Local Tor directory cache. The daemon writes this at runtime.
/tor-data/

# Cached page bundle. build.rs copies it into OUT_DIR and rebuilds it when sources change.
/page/pkg/
/pdf/pkg/

# Runtime and log files
nostorgraph.log
nostorgraph.pid
*.log
*.pid

# Published posts. Shipped pages live in /pages and are copied here when missing.
/content/*.md
# Crawler backoff. Door relays live in code; a missing file starts empty.
/content/relay-pool.json
# Short-link rows and title slugs, written only when those links are saved.
# The lock is a claim hash kept until that save.
/content/seal-rows/
/content/title-slugs/
/content/title-for/
/content/seal-locks/

# Tor backup directories created by run script
onion_backup_*/

# Local configuration overrides
config.local.toml
.env*
*.env

# Editor and IDE files
*.swp
*.swo
*~
.vscode/
.idea/
*.kate-swp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Rust backup files
**/*.rs.bk

# Cache and temporary files
cache/
.cache/
tmp/
temp/
*.tmp
*.temp

# Local development and testing
*.local
.scratch/
test_output/
debug_output/
/logo-proposals/
